<UserControl x:Class="ProductivityWallpaper.App.Views.WallpaperPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tarjeta del wallpaper. El color de estilo siempre va de fondo
             (marco), y arriba se superpone la imagen COMPLETA sin recortar:
             estas imágenes son panorámicas (16:9) y esta tarjeta es más
             angosta y alta, así que recortar para llenarla cortaba la frase
             de los costados. Con la imagen completa, nunca se corta nada. -->
        <Border Grid.Column="0" CornerRadius="18" Effect="{DynamicResource CardShadow}"
                Background="{Binding PlaceholderColorHex, Converter={StaticResource HexToBrushConverter}}">
            <Grid>
                <Border CornerRadius="18"
                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}"
                        RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Background>
                        <MultiBinding Converter="{StaticResource ImageOrColorBrushConverter}">
                            <Binding Path="ImageFullPath" />
                            <Binding Path="PlaceholderColorHex" />
                        </MultiBinding>
                    </Border.Background>
                </Border>

                <Grid Margin="26" Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Quote}" FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{Binding PlaceholderTextColorHex, Converter={StaticResource HexToBrushConverter}}" />

                    <TextBlock Grid.Row="1" Text="{Binding AuthorText}"
                               Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVisibilityConverter}}"
                               FontSize="13" HorizontalAlignment="Right" Margin="0,14,0,0"
                               Foreground="{Binding PlaceholderTextColorHex, Converter={StaticResource HexToBrushConverter}}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Panel derecho: detalles, rotación, "Cambiar ahora" y acceso a configuración -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="{Binding NoContentMessage}" Style="{StaticResource SubtitleText}"
                           Visibility="{Binding HasContent, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                           Margin="0,0,0,16" />

                <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding QuoteLabel}" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Quote}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="{Binding AuthorText}" Style="{StaticResource SubtitleText}"
                               Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,2,0,0" />

                    <TextBlock Text="{Binding CategoriesLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding CategoriesValue}" Style="{StaticResource ValueText}" />
                    <TextBlock Text="{Binding StyleLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding StyleValue}" Style="{StaticResource ValueText}" />
                </StackPanel>

                <!-- Rotación automática: cuenta regresiva + pausar/reanudar -->
                <Border Visibility="{Binding ShowRotationControls, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16,14"
                        Margin="0,20,0,0" Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                         Fill="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding NextChangeLabel}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding RemainingTimeText}" FontSize="18"
                                       FontWeight="SemiBold" FontFamily="Consolas"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Button Content="{Binding PauseResumeText}" Command="{Binding PauseResumeCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Padding="18,8" Margin="0,12,0,0" />

                        <TextBlock Text="{Binding PausedMessage}" FontSize="12" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ManualModeMessage}" FontSize="12" Margin="0,18,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding ShowRotationControls, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                <Button Content="{Binding ChangeNowText}" Command="{Binding ChangeNowCommand}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,6" />

                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                <Border Style="{StaticResource SettingsRow}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StartWithWindowsLabel}" Style="{StaticResource ValueText}"
                                   VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Button Content="{Binding SettingsText}" Command="{Binding OpenSettingsCommand}"
                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="18,8" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
