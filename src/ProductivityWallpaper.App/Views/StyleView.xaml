<UserControl x:Class="ProductivityWallpaper.App.Views.StyleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProductivityWallpaper.App.Controls">
    <Grid x:Name="Root" Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:StepIndicator Grid.Row="0" TotalSteps="{Binding TotalSteps}" CurrentStep="{Binding StepNumber}" Margin="0,0,0,14" />
        <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource TitleText}" Margin="0,0,0,20" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Options}" MaxWidth="480" HorizontalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource CardRadioButton}"
                                     GroupName="Style"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                     Content="{Binding DisplayName}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="{Binding BackText}" Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
            <Button Content="{Binding ContinueText}" Command="{Binding ContinueCommand}"
                    Style="{StaticResource PrimaryButton}" MinWidth="140" />
        </StackPanel>
    </Grid>
</UserControl>
