<UserControl x:Class="ProductivityWallpaper.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Margin="40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Encabezado estilo modal de iOS: título a la izquierda, "Listo"
             a la derecha, sin wizard ni pasos — es una sola pantalla. -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding DoneText}" Command="{Binding DoneCommand}"
                    Style="{StaticResource TextButton}" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                <!-- Idioma: segmented control de dos opciones -->
                <TextBlock Text="{Binding LanguageHeader}" Style="{StaticResource SectionHeaderText}" Margin="4,0,0,8" />
                <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left" Width="220">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="SettingsLanguage" Style="{StaticResource SegmentButton}"
                                     Content="{Binding LanguageEsText}" IsChecked="{Binding IsEsSelected, Mode=TwoWay}" />
                        <RadioButton Grid.Column="1" GroupName="SettingsLanguage" Style="{StaticResource SegmentButton}"
                                     Content="{Binding LanguageEnText}" IsChecked="{Binding IsEnSelected, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- Intereses: selección múltiple en formato "chips" -->
                <TextBlock Text="{Binding InterestsHeader}" Style="{StaticResource SectionHeaderText}" Margin="4,22,0,8" />
                <ItemsControl ItemsSource="{Binding InterestOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource ChipCheckBox}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding DisplayName}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Estilo: selección única -->
                <TextBlock Text="{Binding StyleHeader}" Style="{StaticResource SectionHeaderText}" Margin="4,22,0,8" />
                <ItemsControl ItemsSource="{Binding StyleOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource CardRadioButton}"
                                         GroupName="SettingsStyle"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Content="{Binding DisplayName}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Frecuencia: selección única -->
                <TextBlock Text="{Binding FrequencyHeader}" Style="{StaticResource SectionHeaderText}" Margin="4,22,0,8" />
                <ItemsControl ItemsSource="{Binding FrequencyOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource CardRadioButton}"
                                         GroupName="SettingsFrequency"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Content="{Binding DisplayName}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Rendimiento: bajo / alto -->
                <TextBlock Text="{Binding Texts.PerformanceHeader}" Style="{StaticResource SectionHeaderText}" Margin="4,22,0,8" />
                <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left" Width="220">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="SettingsPerformance" Style="{StaticResource SegmentButton}"
                                     Content="{Binding Texts.PerformanceLow}" IsChecked="{Binding IsPerformanceLow, Mode=TwoWay}" />
                        <RadioButton Grid.Column="1" GroupName="SettingsPerformance" Style="{StaticResource SegmentButton}"
                                     Content="{Binding Texts.PerformanceHigh}" IsChecked="{Binding IsPerformanceHigh, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Texts.PerformanceHint}" Style="{StaticResource SubtitleText}"
                           FontSize="12" Margin="4,8,0,0" />

                <!-- Widgets de escritorio -->
                <TextBlock Text="{Binding Texts.WidgetsHeader}" Style="{StaticResource SectionHeaderText}" Margin="4,22,0,8" />
                <CheckBox Style="{StaticResource ToggleRow}" Content="{Binding Texts.ClockWidget}"
                          IsChecked="{Binding ShowClockWidget, Mode=TwoWay}" />
                <CheckBox Style="{StaticResource ToggleRow}" Content="{Binding Texts.ClockSeconds}"
                          IsChecked="{Binding ClockShowSeconds, Mode=TwoWay}" IsEnabled="{Binding CanShowSeconds}" />
                <CheckBox Style="{StaticResource ToggleRow}" Content="{Binding Texts.Clock24Hour}"
                          IsChecked="{Binding Clock24Hour, Mode=TwoWay}" />
                <CheckBox Style="{StaticResource ToggleRow}" Content="{Binding Texts.ClockDate}"
                          IsChecked="{Binding ClockShowDate, Mode=TwoWay}" />
                <CheckBox Style="{StaticResource ToggleRow}" Content="{Binding Texts.DayProgressWidget}"
                          IsChecked="{Binding ShowDayProgressWidget, Mode=TwoWay}" />
                <CheckBox Style="{StaticResource ToggleRow}" Content="{Binding Texts.WidgetCard}"
                          IsChecked="{Binding WidgetCardBackground, Mode=TwoWay}" />

                <TextBlock Text="{Binding Texts.WidgetSize}" Style="{StaticResource LabelText}" Margin="4,10,0,6" />
                <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left" Width="330">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="SettingsWidgetSize" Style="{StaticResource SegmentButton}"
                                     Content="{Binding Texts.SizeSmall}" IsChecked="{Binding IsWidgetSizeSmall, Mode=TwoWay}" />
                        <RadioButton Grid.Column="1" GroupName="SettingsWidgetSize" Style="{StaticResource SegmentButton}"
                                     Content="{Binding Texts.SizeMedium}" IsChecked="{Binding IsWidgetSizeMedium, Mode=TwoWay}" />
                        <RadioButton Grid.Column="2" GroupName="SettingsWidgetSize" Style="{StaticResource SegmentButton}"
                                     Content="{Binding Texts.SizeLarge}" IsChecked="{Binding IsWidgetSizeLarge, Mode=TwoWay}" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Texts.WidgetsHint}" Style="{StaticResource SubtitleText}"
                           FontSize="12" Margin="4,8,0,0" />

                <!-- Sistema: inicio automático con Windows -->
                <TextBlock Text="{Binding SystemHeader}" Style="{StaticResource SectionHeaderText}" Margin="4,22,0,8" />
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StartWithWindowsLabel}" Style="{StaticResource ValueText}"
                                   VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Espacio final para que el scroll no termine pegado al
                     borde de la ventana. -->
                <Border Height="20" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
