<UserControl x:Class="ProductivityWallpaper.App.Views.LanguageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProductivityWallpaper.App.Controls">
    <Grid x:Name="Root">
        <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:StepIndicator TotalSteps="{Binding TotalSteps}" CurrentStep="{Binding StepNumber}" Margin="0,0,0,18" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" Margin="0,0,0,24" />

            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource LanguageCardButton}"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Language}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Flag}" FontSize="20" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ValueText}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="{Binding BackText}" Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
