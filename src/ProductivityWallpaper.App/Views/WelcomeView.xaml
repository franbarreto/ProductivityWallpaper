<UserControl x:Class="ProductivityWallpaper.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="44" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center" Margin="0,0,0,22" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" TextAlignment="Center" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleText}" TextAlignment="Center" Margin="0,14,0,30" />
            <Button Content="{Binding StartText}" Command="{Binding StartCommand}"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" MinWidth="180" />
        </StackPanel>
    </Grid>
</UserControl>
