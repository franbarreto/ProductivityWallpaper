<UserControl x:Class="ProductivityWallpaper.App.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ProductivityWallpaper.App.Controls">
    <Grid x:Name="Root">
        <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:StepIndicator TotalSteps="{Binding TotalSteps}" CurrentStep="{Binding StepNumber}" Margin="0,0,0,14" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" Margin="0,0,0,10" />

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20"
                    Effect="{DynamicResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding LanguageValue}" Style="{StaticResource ValueText}" />

                    <TextBlock Text="{Binding InterestsLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding InterestsValue}" Style="{StaticResource ValueText}" />

                    <TextBlock Text="{Binding StyleLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding StyleValue}" Style="{StaticResource ValueText}" />

                    <TextBlock Text="{Binding FrequencyLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding FrequencyValue}" Style="{StaticResource ValueText}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button Content="{Binding BackText}" Command="{Binding BackCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                        Style="{StaticResource PrimaryButton}" MinWidth="140" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
