<Window x:Class="ProductivityWallpaper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productivity Wallpaper" Height="560" Width="900"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <!-- El ContentControl muestra el UserControl que corresponda al ViewModel
         actual (ver DataTemplates en App.xaml). Una sola ventana, sin popups. -->
    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
